# Nachfolger des cage-Kiosks: gleiche Idee (foot bildschirmfuellend), aber mit
# Fensterwechsel und einer Zwischenablage, die alle Clients teilen.
# Alt-Tab bleibt absichtlich frei -- das gehoert tmux. Hier zaehlt Super (Cmd).

set $mod Mod4
set $term foot
set $browser google-chrome-stable --ozone-platform-hint=auto --force-device-scale-factor=2

# Fenster liegen als Tabs uebereinander statt nebeneinander: jedes ist voll
# gross, die Tableiste oben zeigt, was sonst noch offen ist.
workspace_layout tabbed
default_border none
# --i3 blendet die Tableiste aus, solange nur ein Fenster im Tab-Container
# liegt -- bei einem einzelnen foot sieht es also aus wie frueher unter cage.
hide_edge_borders --i3 smart
font pango:Cascadia Mono NF 16

focus_follows_mouse no
# Scale 1 wie unter cage, damit foot.ini (Schrift 22, dpi-aware=no) passt.
# Chrome bekommt seinen HiDPI-Faktor stattdessen per Flag.
output eDP-1 scale 1

# Touchpad: Antippen zaehlt als Klick (libinput hat tap standardmaessig aus).
# Zwei Finger = rechte Taste, drei = mittlere.
input "1452:602:bcm5974" {
    tap enabled
    tap_button_map lrm
    # Scrollrichtung wie unter macOS: Inhalt folgt den Fingern.
    natural_scroll enabled
    # dwt ist libinput-Default, hier nur explizit festgehalten.
    dwt enabled
}

bindsym $mod+Tab       focus next
bindsym $mod+Shift+Tab focus prev
bindsym $mod+Left      focus left
bindsym $mod+Right     focus right
bindsym $mod+Return    exec $term
bindsym $mod+b         exec $browser
bindsym $mod+d         exec fuzzel
bindsym $mod+q         kill
bindsym $mod+f         fullscreen toggle
bindsym $mod+Shift+c   reload
bindsym $mod+Shift+e   exec swaymsg exit

# Die F3-Sondertaste der Mac-Tastatur (Mission Control) sendet KEY_SCALE, also
# evdev 120 = Keycode 128. Ein Keysym gibt es dafuer nicht, darum bindcode; und
# im Terminal kommt sie gar nicht erst an, darum hier statt in der tmux.conf.
# Allein: eine Ansicht weiter (Fenster, bzw. Pane wenn zusammengeholt).
# Mit Ctrl: Ansichtsmodus im Kreis -- nebeneinander, Raster, Tabs.
# --no-repeat: sway feuert ein Binding sonst beim Halten der Taste wiederholt.
bindcode --no-repeat 128      exec ~/.local/bin/tmux-cycle-view --next
bindcode --no-repeat Ctrl+128 exec ~/.local/bin/tmux-cycle-view

# Helligkeit macht idle-dim (System-Dienst, liest /dev/input direkt) -- hier
# bewusst KEINE Bindings. Mit beiden lief pro Tastendruck zweierlei: sways
# lineare 5-Prozentpunkte und die feine Stufentabelle von idle-dim, die
# Ergebnisse addierten sich (1 % + 5 % = 6 %) und die Unterkante blieb bei
# 5 % haengen.

# Startfenster: foot mit tmux/Claude (Stufe 2 aus tty-claude.sh). Nur dieses
# eine bekommt die Kiosk-Stufe -- weitere Terminals (Super+Return) sollen eine
# normale Shell sein und nicht dieselbe tmux-Session spiegeln.
exec env AUTOCLAUDE_STAGE=kiosk $term
