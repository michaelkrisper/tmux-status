#!/bin/sh
# Schaltet die Ansicht einer tmux-Session weiter:
#   nebeneinander (even-horizontal) -> Raster (tiled) -> Tabs (je ein Fenster)
#
# Aufruf mit einer Fenster-ID als Argument (aus tmux heraus: "#{window_id}").
# Ohne Argument -- etwa aus einer Compositor-Taste heraus -- wird das Fenster
# des zuletzt aktiven angehaengten Clients genommen.
#
# Jedes tmux-Kommando bekommt ein explizites -t. Ohne Ziel greifen sie auf die
# zuletzt benutzte Session zu, nicht auf die gemeinte: dann raeumt der Zyklus
# eine fremde Session leer.
set -eu

# Ohne Schalter: Ansichtsmodus weiterdrehen.
#   --next  nur weiterschalten (Fenster, bzw. Pane wenn zusammengeholt)
#   --new   ein Terminal dazu -- als Fenster im Tab-Modus, sonst als Pane
# Alle drei stecken hier, weil sie dieselbe Frage beantworten muessen: welche
# Session sieht der User gerade an?
action=cycle
case "${1:-}" in
    --next) action=next; shift ;;
    --new)  action=new;  shift ;;
esac

# Entprellung. Die Taste kommt gelegentlich zweimal an -- je nach Ursache als
# Wiederholung beim Halten oder als zweites Event eines parallelen Geraets
# (Apple-Tastaturen melden Sondertasten teils zusaetzlich ueber den Video-Bus).
# Ein zweiter Aufruf binnen 200 ms ist nie eine Absicht.
stamp=${XDG_RUNTIME_DIR:-/tmp}/.tmux-cycle-view.stamp
now=$(date +%s%3N)
last=$(cat "$stamp" 2>/dev/null || echo 0)
if [ "$((now - last))" -lt 200 ]; then
    exit 0
fi
echo "$now" > "$stamp"

win=${1:-}
if [ -z "$win" ]; then
    # Die Session des zuletzt aktiven angehaengten Clients -- das ist die,
    # die der User gerade ansieht. Weder "display -p" ohne Ziel noch
    # "display -p -c <client>" taugen dafuer: beide liefern die zuletzt
    # benutzte Session, -c waehlt nur das Ausgabeziel. Also ueber
    # #{client_session} gehen und das als -t setzen.
    sess=$(tmux list-clients -F '#{client_activity} #{client_session}' 2>/dev/null |
           sort -n | tail -n 1 | cut -d' ' -f2-)
    [ -n "$sess" ] || exit 0
    win=$(tmux display-message -p -t "$sess" '#{window_id}')
fi

# Mehr als ein Fenster heisst Tab-Modus, egal was zuletzt gemerkt wurde --
# der User kann jederzeit von Hand Fenster aufmachen.
windows=$(tmux list-windows -t "$win" -F x | wc -l)
mode=$(tmux show-options -qv -t "$win" @viewmode || true)
[ "$windows" -gt 1 ] && mode=tabs

if [ "$action" = next ]; then
    if [ "$windows" -gt 1 ]; then
        tmux next-window -t "$win"
    else
        tmux select-pane -t "$win.+"
    fi
    exit 0
fi

# Ein neues Terminal muss dorthin, wo die Ansicht gerade ist: im Tab-Modus als
# eigenes Fenster, sonst als Pane -- sonst liegt es ausserhalb des Layouts und
# kippt die Ansicht nebenbei zurueck in den Tab-Modus.
if [ "$action" = new ]; then
    case "$mode" in
        horizontal|tiled)
            if [ "$mode" = horizontal ]; then lay=even-horizontal; else lay=tiled; fi
            tmux split-window -t "$win" -c '#{pane_current_path}'
            tmux select-layout -t "$win" "$lay"
            ;;
        *)
            # -a: hinter das aktuelle Fenster. Ohne das liest tmux das Ziel als
            # Position und bricht mit "index in use" ab.
            tmux new-window -a -t "$win" -c '#{pane_current_path}'
            ;;
    esac
    exit 0
fi

gather() {
    tmux list-windows -t "$win" -F '#{window_id}' | grep -vx "$win" | while read -r w; do
        tmux join-pane -s "$w" -t "$win"
        # Nach jedem Schritt neu anordnen, sonst geht ab ein paar Fenstern
        # der Platz fuer den naechsten Pane aus.
        tmux select-layout -t "$win" even-horizontal
    done
}

case "$mode" in
    horizontal)
        gather
        tmux select-layout -t "$win" tiled
        new=tiled
        ;;
    tiled)
        tmux list-panes -t "$win" -F '#{pane_id}' | tail -n +2 | while read -r p; do
            tmux break-pane -d -a -s "$p" -t "$win"
        done
        new=tabs
        ;;
    *)
        gather
        tmux select-layout -t "$win" even-horizontal
        new=horizontal
        ;;
esac

tmux set-option -t "$win" @viewmode "$new"
tmux display-message -t "$win" "Ansicht: $new"
