#!/usr/bin/env bash
# usb - Stick einhaengen, eine Datei per fzf auswaehlen, auf den Stick
#       verschieben, Stick wieder aushaengen und stromlos schalten.
#
# USB_DEST=/pfad  schiebt stattdessen in diesen Ordner (Test, kein Stick noetig)
#
# Ohne Desktop ruft niemand udisks auf; der Dienst ist da und wird per D-Bus
# gestartet, sobald udisksctl ihn braucht.
set -u

SRC=$(sed -n 's/^DestDir=//p' "$HOME/.config/Momentum/nzbget.conf" 2>/dev/null)
: "${SRC:=$HOME/Documents/Momentum/Downloads}"
[ -d "$SRC" ] || { echo "gibt es nicht: $SRC" >&2; exit 1; }

# Partitionen auf Wechselmedien: NAME PKNAME je Zeile
parts() {
    lsblk -rno NAME,RM,TYPE,PKNAME | awk '$2==1 && $3=="part" {print $1, $4}'
}

if [ -n "${USB_DEST:-}" ]; then
    dest=$USB_DEST
else
    mps=()
    while read -r name pk; do
        mp=$(findmnt -no TARGET "/dev/$name") ||
            mp=$(udisksctl mount -b "/dev/$name" --no-user-interaction | sed 's/^Mounted .* at //') ||
            { echo "/dev/$name laesst sich nicht einhaengen (Dateisystem kaputt? -> fsck)" >&2; continue; }
        [ -d "$mp" ] && mps+=("$mp")
    done < <(parts)
    case ${#mps[@]} in
        0) echo "kein Stick da" >&2; exit 1 ;;
        1) dest=${mps[0]} ;;
        *) dest=$(printf '%s\n' "${mps[@]}" | fzf --height=20% --prompt='Ziel> ') || exit 1 ;;
    esac
fi

f=$(find "$SRC" -mindepth 1 -maxdepth 1 -not -name '.*' -printf '%f\n' |
    sort | fzf --height=80% --border --prompt="verschieben nach $dest> ")
[ -n "$f" ] || { echo "nichts ausgewaehlt"; exit 0; }

need=$(du -sb --apparent-size "$SRC/$f" | cut -f1)
free=$(df -B1 --output=avail "$dest" | tail -1)
if [ "$need" -gt "$free" ]; then
    printf 'zu wenig Platz: %s noetig, %s frei\n' \
        "$(numfmt --to=iec "$need")" "$(numfmt --to=iec "$free")" >&2
    exit 1
fi

# --remove-source-files loescht nur, was wirklich angekommen ist
rsync -a --info=progress2 --remove-source-files "$SRC/$f" "$dest/" || exit 1
find "$SRC/$f" -type d -empty -delete 2>/dev/null
sync

[ -n "${USB_DEST:-}" ] && { echo fertig; exit 0; }
disks=""
while read -r name pk; do
    findmnt -no TARGET "/dev/$name" >/dev/null &&
        udisksctl unmount -b "/dev/$name" --no-user-interaction
    case " $disks " in *" $pk "*) ;; *) disks="$disks $pk";; esac
done < <(parts)
for d in $disks; do
    udisksctl power-off -b "/dev/$d" --no-user-interaction
done
echo "fertig, Stick kann abgezogen werden"
