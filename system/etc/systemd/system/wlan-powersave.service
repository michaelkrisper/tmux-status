[Unit]
Description=WLAN Power Save
After=network.target

[Service]
# Type=simple statt oneshot: das Skript wartet auf den Connect, bevor es
# power_save setzt. Als oneshot haette multi-user.target darauf gewartet und
# der Boot sich um ~8,6 s verzoegert (gemessen 2026-08-31). Als simple laeuft
# es im Hintergrund weiter, ohne die Startkette aufzuhalten.
Type=simple
ExecStart=/usr/local/bin/wlan-powersave.sh

[Install]
WantedBy=multi-user.target
