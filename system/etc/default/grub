GRUB_TIMEOUT=0
# hidden statt 0-ohne-Menue: Esc oder Shift beim Booten holt das Menue
# trotzdem hervor -- noetig, um auf 7.1.9 (mit acpi_osi=!Darwin) zurueckzukommen.
GRUB_TIMEOUT_STYLE=hidden
GRUB_DISTRIBUTOR="$(sed 's, release .*$,,g' /etc/system-release)"
GRUB_DEFAULT=saved
GRUB_DISABLE_SUBMENU=true
GRUB_TERMINAL_OUTPUT="console"
GRUB_CMDLINE_LINUX="rhgb quiet mem_sleep_default=deep pcie_aspm.policy=powersave i915.enable_psr=2 i915.enable_fbc=1 thunderbolt.hosts_only=1 acpi_osi=!Darwin intel_pstate=active"
GRUB_DISABLE_RECOVERY="true"
GRUB_ENABLE_BLSCFG=true
